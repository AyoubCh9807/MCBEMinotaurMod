{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minotaur": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "running": "query.modified_move_speed > 0.1"
            }
          ],
          "blend_transition": 0.2
        },
        "running": {
          "animations": [
            "running"
          ],
          "particle_effects": [
            {
              "effect": "dust"
            }
          ],
          "transitions": [
            {
              "idle": "query.modified_move_speed < 0.05"
            }
          ],
          "blend_transition": 0.2
        }
      }
    }
  }
}